{
 "op": "worktree-create",
 "http": {
  "method": "POST",
  "path": "/api/worktrees",
  "body": {
   "base": "main",
   "branch": "feat-y",
   "cwd": "$TMP/repo"
  },
  "status": 200,
  "response": {
   "ok": true,
   "workspaceId": "w9",
   "checkoutPath": "$TMP/repo-wt-feat-y",
