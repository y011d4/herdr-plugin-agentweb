  }
 },
 "herdr": [
  {
   "method": "worktree.create",
   "params": {
    "focus": false,
    "cwd": "$TMP/repo",
    "branch": "feat-y",
    "base": "main",
    "path": "$TMP/repo-wt-feat-y"
   }
  }
 ]
}
