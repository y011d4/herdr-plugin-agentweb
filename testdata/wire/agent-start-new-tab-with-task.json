{
 "op": "agent-start-new-tab-with-task",
 "http": {
  "method": "POST",
  "path": "/api/agents",
  "body": {
   "cwd": "$TMP/repo",
   "name": "w-tab",
   "profile": "claude",
   "task": "do it"
  },
  "status": 200,
  "response": {
   "ok": true,
