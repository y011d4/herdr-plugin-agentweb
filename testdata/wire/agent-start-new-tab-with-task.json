  },
  {
   "method": "agent.start",
   "params": {
    "name": "w-tab",
    "kind": "claude",
    "pane_id": "p10",
    "args": []
   }
  },
  {
   "method": "agent.start",
   "params": {
    "name": "w-tab",
    "kind": "claude",
    "pane_id": "p10",
    "args": []
   }
  },
  {
   "method": "agent.get",
   "params": {
    "target": "p10"
   }
  },
  {
   "method": "agent.get",
   "params": {
    "target": "p10"
   }
  },
  {
   "method": "agent.prompt",
   "params": {
    "target": "p10",
    "text": "do it"
   }
  }
 ]
}
