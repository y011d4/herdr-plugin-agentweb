{
  "compilerOptions": {
    "strict": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx"],
  "exclude": ["web/src/sw.ts"]
}
